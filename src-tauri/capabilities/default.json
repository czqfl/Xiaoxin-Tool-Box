{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "所有窗口共享的基础权限",
  "windows": ["settings", "clipboard-panel", "folder-panel", "credential-panel", "port-panel", "files-panel", "snippets-panel", "translate-popup", "palette", "toolbar", "shot-overlay-*", "pin-*", "pin-staging", "rec-select", "rec-bar", "rec-vol", "note_*", "particles", "sticky-history", "sticky-imageviewer", "sticky-settings"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-is-visible",
    "core:window:allow-is-focused",
    "core:window:allow-center",
    "core:window:allow-set-always-on-top",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-create",
    "core:event:allow-emit-to",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:image:default",
    "updater:default",
    "process:allow-restart",
    "opener:default",
    "dialog:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
