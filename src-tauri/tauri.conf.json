{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小心工具箱",
  "version": "1.0.1",
  "identifier": "com.xiaoxin.toolbox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1423",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "小心工具箱 - 设置",
        "width": 920,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "visible": false
      },
      {
        "label": "clipboard-panel",
        "title": "剪贴板",
        "width": 640,
        "height": 560,
        "resizable": false,
        "fullscreen": false,
        "maximized": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "folder-panel",
        "title": "文件夹",
        "width": 700,
        "height": 540,
        "resizable": false,
        "fullscreen": false,
        "maximized": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "git-run",
        "title": "Git 执行结果",
        "width": 460,
        "height": 440,
        "resizable": false,
        "fullscreen": false,
        "maximized": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "credential-panel",
        "title": "账号密码",
        "width": 640,
        "height": 640,
        "resizable": false,
        "fullscreen": false,
        "maximized": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "port-panel",
        "title": "端口工具",
        "width": 580,
        "height": 420,
        "resizable": false,
        "fullscreen": false,
        "maximized": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "files-panel",
        "title": "快速文件",
        "width": 760,
        "height": 560,
        "minWidth": 520,
        "minHeight": 380,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "snippets-panel",
        "title": "常用语速贴",
        "width": 380,
        "height": 560,
        "minWidth": 320,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "palette",
        "title": "命令面板",
        "width": 780,
        "height": 600,
        "resizable": false,
        "fullscreen": false,
        "maximized": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "toolbar",
        "title": "悬浮工具栏",
        "width": 188,
        "height": 36,
        "resizable": false,
        "fullscreen": false,
        "maximized": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "translate-popup",
        "title": "翻译",
        "width": 580,
        "height": 440,
        "resizable": false,
        "fullscreen": false,
        "maximized": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "toolbar-tip",
        "title": "悬浮提示",
        "width": 200,
        "height": 32,
        "resizable": false,
        "fullscreen": false,
        "maximized": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "particles",
        "title": "粒子层",
        "url": "index.html",
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "focusable": false,
        "resizable": true,
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "ocr-models/PP-OCRv6_det_tiny.onnx": "PP-OCRv6_det_tiny.onnx",
      "ocr-models/PP-OCRv6_rec_tiny.onnx": "PP-OCRv6_rec_tiny.onnx",
      "ocr-models/ppocrv6_tiny_dict.txt": "ppocrv6_tiny_dict.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
