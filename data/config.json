{
  "clipboard": {
    "max_history": 200,
    "watch_images": true,
    "watch_files": true,
    "close_after_paste": true,
    "always_on_top": false,
    "paste_mode": "normal"
  },
  "folder": {
    "show_visit_count": true,
    "layout": "grid",
    "split": "columns",
    "page_size": 12,
    "always_on_top": false,
    "track_explorer": true,
    "terminal_shell": "powershell",
    "vscode_path": null
  },
  "credentials": {
    "always_on_top": false,
    "show_passwords": false
  },
  "shortcuts": {
    "clipboard": "Alt+C",
    "folder": "Alt+F",
    "credentials": "Alt+A",
    "translation": "Alt+S",
    "port": "Alt+P"
  },
  "general": {
    "theme": "red",
    "silent_start": true,
    "language": "zh-CN",
    "acrylic_enabled": true,
    "acrylic_opacity": 60
  },
  "translator": {
    "provider": "youdao",
    "youdao_key": "",
    "youdao_secret": "",
    "baidu_appid": "",
    "baidu_secret": "",
    "target_lang": "zh",
    "always_on_top": false
  },
  "port": {
    "always_on_top": false
  },
  "toolbar": {
    "enabled": true,
    "tools": [
      "clipboard",
      "folder",
      "credentials",
      "translation",
      "port",
      "settings"
    ],
    "orientation": "vertical",
    "auto_hide": true
  },
  "panel_positions": {}
}